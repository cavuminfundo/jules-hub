# Julius Hub v3 Configuration Example

# Server & Ports
PORT=4100
JULIUS_PORT=4100
CDP_PORT=9000
CDP_URL=http://127.0.0.1:9000

# Storage & Worktrees Directories
JULIUS_DATA_DIR=./data
JULIUS_WORKTREES_DIR=./worktrees
JULIUS_WORKSPACES_ROOT=/workspaces
PROJECTS_REGISTRY_PATH=./data/projects_registry.json

# Local / Remote LLM Engines
OLLAMA_HOST=http://localhost:11434
LOCAL_LLM_OFFLOAD_SCRIPT=

# API & Cloud Integrations (optional, can also be set via UI Settings)
GITHUB_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
